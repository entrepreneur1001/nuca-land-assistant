# All values here are PUBLIC (safe in the browser). There is no Gemini API key: AI goes through Firebase AI Logic.
# Fraud Defense (reCAPTCHA Enterprise) site key registered in Firebase App Check (required for the AI button in production).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Google Analytics for Firebase.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-GBV8B6PJ55
# Optional: Gemini models tried in order via Firebase AI Logic.
# NEXT_PUBLIC_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Local dev only: App Check debug token registered in the console (ignored by production builds).
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Set to "local" to read public/dev-snapshot instead of Firestore (npm run dev:local does this).
# NEXT_PUBLIC_DATA=local

# ---- Sync job (GitHub Actions secret FIREBASE_SERVICE_ACCOUNT holds the Admin JSON; the official site needs no credentials) ----
# OFFICIAL_BASE_URL=https://lands.nuca.gov.eg
# OFFICIAL_DELAY_MS=500
# OFFICIAL_CONCURRENCY=2
# OFFICIAL_BUDGET_MS=780000
# OFFICIAL_MAX_NEWLY_BOOKED=1500
# NUCA_NEWS_URL=https://lands.nuca.gov.eg/ar/NewsList.aspx
