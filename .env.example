# --- Secrets (put real values in .env.local, which is gitignored) ---
# Google Gemini key, used server-side only. Never exposed to the browser.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-2.5-flash

# --- Database ---
# Leave empty to use the embedded Postgres (PGlite) stored in ./data/pglite. No install needed.
# Set to use a real PostgreSQL server, e.g. the one from docker-compose.yml:
# DATABASE_URL=postgres://nuca:nuca@localhost:5432/nuca
DATABASE_URL=

# --- Data source ---
# Public read-only JSON API of the existing tracker (mirrors the official NUCA inventory).
SOURCE_API_URL=https://api.baytwaten4all.online
SOURCE_TIMEZONE=Africa/Cairo

# --- Polling (be gentle with the source) ---
STATS_POLL_SECONDS=60
MIN_FULL_SYNC_MINUTES=5
MAX_FULL_SYNC_MINUTES=30
REFERENCE_POLL_MINUTES=30
PAGE_SIZE=1000
PAGE_DELAY_MS=1000
STALE_AFTER_MINUTES=10
AI_TTL_MINUTES=60
# Set to 1 to stop the background ingest worker (e.g. when running scripts).
DISABLE_WORKER=

# --- Defaults for the first profile (editable later in Settings) ---
DEFAULT_RANK=17000
DEFAULT_MONEY_PAID=39500

# --- Optional basic auth for /settings and API writes ---
ADMIN_PASSWORD=
