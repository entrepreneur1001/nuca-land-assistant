rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only market data. Written only by the sync job (Admin SDK bypasses rules).
    match /meta/{doc} { allow read: if true; allow write: if false; }
    match /plots/{chunk} { allow read: if true; allow write: if false; }

    // Shared cache of validated AI analyses, keyed by hash(profile + data version + model).
    // Anyone may read; signed-in (anonymous) visitors may create once. No updates or deletes.
    match /ai_cache/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && key.size() <= 16
        && request.resource.data.keys().hasOnly(['response', 'model', 'dataVersion', 'createdAt'])
        && request.resource.data.response is map
        && request.resource.data.response.recommendations is list
        && request.resource.data.response.recommendations.size() <= 20
        && request.resource.data.model is string && request.resource.data.model.size() < 64
        && request.resource.data.dataVersion is string && request.resource.data.dataVersion.size() < 32
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() < 40;
      allow update, delete: if false;
    }

    // Visitor feedback / suggestions. Create-only for signed-in (anonymous) visitors; read from the console.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type', 'message', 'contact', 'page', 'ua', 'createdAt'])
        && request.resource.data.type in ['suggestion', 'bug', 'data']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 1000
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 100))
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && (!('ua' in request.resource.data) || (request.resource.data.ua is string && request.resource.data.ua.size() <= 200))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
