rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only market data. Written only by the sync job (Admin SDK bypasses rules).
    match /meta/{doc} { allow read: if true; allow write: if false; }
    match /plots/{chunk} { allow read: if true; allow write: if false; }

    // Shared cache of validated AI analyses, keyed by hash(profile + data version + model).
    // Anyone may read; signed-in (anonymous) visitors may create once. No updates or deletes.
    match /ai_cache/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && key.size() <= 16
        && request.resource.data.keys().hasOnly(['response', 'model', 'dataVersion', 'createdAt'])
        && request.resource.data.response is map
        && request.resource.data.response.recommendations is list
        && request.resource.data.response.recommendations.size() <= 20
        && request.resource.data.model is string && request.resource.data.model.size() < 64
        && request.resource.data.dataVersion is string && request.resource.data.dataVersion.size() < 32
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() < 40;
      allow update, delete: if false;
    }

    // Visitor feedback / suggestions. Create-only for signed-in (anonymous) visitors; read from the console.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type', 'message', 'contact', 'page', 'ua', 'createdAt'])
        && request.resource.data.type in ['suggestion', 'bug', 'data']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 1000
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 100))
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && (!('ua' in request.resource.data) || (request.resource.data.ua is string && request.resource.data.ua.size() <= 200))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // «نبهني لما تتحجز»: a browser's push token + the plots it saved and the cities / districts it follows, one doc per
    // anonymous visitor (src/lib/push.ts). Only the owner writes it; nobody reads it from the client. The sync job
    // (Admin SDK) reads it and sends the pushes.
    match /watchers/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'plots', 'areas', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() < 4096
        && request.resource.data.plots is list && request.resource.data.plots.size() <= 50
        && (!('areas' in request.resource.data) || (request.resource.data.areas is list && request.resource.data.areas.size() <= 20))
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read: if false;
    }

    // /impact: totals the sync job writes (notifications sent, people with alerts on, what they save and follow). Public, no personal data.
    match /stats/{doc} { allow read: if true; allow write: if false; }

    // Notification opens per Cairo day (src/lib/usage.ts): a visitor arriving from a push adds exactly one.
    match /opens/{day} {
      allow read: if true;
      allow create: if request.auth != null && day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // Sync job's source credentials (Admin SDK only).
    match /private/{doc} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
